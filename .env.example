# 환경변수 템플릿 (실제 값은 커밋 금지)
# 운영: 웹루트 밖 /app/.env 로 업로드   |   로컬: 프로젝트 루트 .env.local 로 복사해 사용
#   cp .env.example .env.local

# OpenAI (AI 상담)
OPENAI_API_KEY=

# MySQL
DB_HOST=localhost
DB_NAME=tomokmall
DB_USER=tomokmall
DB_PASS=

# FTP 배포 (scripts/deploy.sh가 .env.local에서 자동 로드 — 로컬 전용, 서버 /app/.env에는 넣지 않음)
FTP_PASS=

# 로컬 테스트 계정 (scripts/local-test-accounts.php 전용 — .env.local 에만 값 입력, 운영 /app/.env 에는 넣지 않음)
LOCAL_TEST_CUSTOMER_EMAIL=
LOCAL_TEST_CUSTOMER_PASSWORD=
LOCAL_TEST_CORPORATE_EMAIL=
LOCAL_TEST_CORPORATE_PASSWORD=

# 국가법령정보 공동활용 OPEN API 인증값(OC) — scripts/legal-sources/law_api_sync.php 전용(법령 개정 대조).
# open.law.go.kr 에서 발급. 값은 .env.local 에만(채팅·커밋 금지). 웹 화면은 사용하지 않으므로 운영 /app/.env 에는 넣지 않아도 됨.
LAW_API_OC=

# 공공데이터포털 일반 인증키(조달청_나라장터쇼핑몰 품목정보 서비스 등) — scripts/external/g2b-api.php 전용(외부 상품 참고 자료 수집).
# data.go.kr 마이페이지에서 'Decoding' 키를 넣는다(Encoding 키도 동작). 값은 .env.local 에만(채팅·커밋 금지). 운영 /app/.env 에는 넣지 않음.
DATA_GO_KR_SERVICE_KEY=

# 문자 발송(관리자 '상담 요청' 상세의 문자 답변) — app/sms.php. 운영 /app/.env 에 값 입력(커밋·채팅 금지)
# SMS_PROVIDER: solapi 또는 aligo. 발신번호(SMS_SENDER)는 발송 업체에 사전 등록한 번호여야 함
SMS_PROVIDER=
SMS_API_KEY=
# solapi 만: API Secret
SMS_API_SECRET=
# aligo 만: 알리고 아이디
SMS_USER_ID=
SMS_SENDER=
# 선택: 관리자 화면 '보내는 사람' 표시명(기본 비엠아이토목건축자재), 알리고 시험 모드(Y = 실제 발송 안 함)
SMS_SENDER_NAME=
SMS_TEST_MODE=
