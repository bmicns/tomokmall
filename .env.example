# 환경변수 템플릿 (실제 값은 커밋 금지)
# 운영: 웹루트 밖 /app/.env 로 업로드   |   로컬: 프로젝트 루트 .env.local 로 복사해 사용
#   cp .env.example .env.local

# OpenAI (AI 상담)
OPENAI_API_KEY=

# MySQL
DB_HOST=localhost
DB_NAME=tomokmall
DB_USER=tomokmall
DB_PASS=

# FTP 배포 (scripts/deploy.sh가 .env.local에서 자동 로드 — 로컬 전용, 서버 /app/.env에는 넣지 않음)
FTP_PASS=

# 로컬 테스트 계정 (scripts/local-test-accounts.php 전용 — .env.local 에만 값 입력, 운영 /app/.env 에는 넣지 않음)
LOCAL_TEST_CUSTOMER_EMAIL=
LOCAL_TEST_CUSTOMER_PASSWORD=
LOCAL_TEST_CORPORATE_EMAIL=
LOCAL_TEST_CORPORATE_PASSWORD=

# 국가법령정보 공동활용 OPEN API 인증값(OC) — scripts/legal-sources/law_api_sync.php 전용(법령 개정 대조).
# open.law.go.kr 에서 발급. 값은 .env.local 에만(채팅·커밋 금지). 웹 화면은 사용하지 않으므로 운영 /app/.env 에는 넣지 않아도 됨.
LAW_API_OC=
