# 환경변수 템플릿 (실제 값은 커밋 금지)
# 운영: 웹루트 밖 /app/.env 로 업로드   |   로컬: 프로젝트 루트 .env.local 로 복사해 사용
#   cp .env.example .env.local

# OpenAI (AI 상담)
OPENAI_API_KEY=

# MySQL
DB_HOST=localhost
DB_NAME=tomokmall
DB_USER=tomokmall
DB_PASS=

# FTP 배포 (scripts/deploy.sh가 .env.local에서 자동 로드 — 로컬 전용, 서버 /app/.env에는 넣지 않음)
FTP_PASS=

# Docker 로컬 실행(docker compose) 전용 — 이 두 값은 .env.local 이 아니라 '프로젝트 루트 .env'(커밋 금지)에 넣는다.
# docker compose 가 루트 .env 를 읽어 docker-compose.yml 에 채운다. 비어 있으면 docker compose 가 시작하지 않고 안내한다.
# 운영 DB · 다른 계정과 다른 값을 쓴다. (기존 mysql_data 볼륨은 처음 만들 때의 비밀번호를 유지 — docs/DEPLOYMENT.md 8장)
LOCAL_DB_PASS=
LOCAL_DB_ROOT_PASS=

# 일회성 DB 보정 스크립트(scripts/db-tools/*.php) 접근 키 — 24자 이상 무작위 값. 비어 있으면 모든 스크립트가 403 으로 거부.
# 필요할 때만 넣고 작업 후 지운다. 생성 예: php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'  (값은 채팅·문서·커밋 금지)
DB_TOOL_KEY=

# 로컬 테스트 계정 (scripts/local-test-accounts.php 전용 — .env.local 에만 값 입력, 운영 /app/.env 에는 넣지 않음)
LOCAL_TEST_CUSTOMER_EMAIL=
LOCAL_TEST_CUSTOMER_PASSWORD=
LOCAL_TEST_CORPORATE_EMAIL=
LOCAL_TEST_CORPORATE_PASSWORD=

# 국가법령정보 공동활용 OPEN API 인증값(OC) — scripts/legal-sources/law_api_sync.php 전용(법령 개정 대조).
# open.law.go.kr 에서 발급. 값은 .env.local 에만(채팅·커밋 금지). 웹 화면은 사용하지 않으므로 운영 /app/.env 에는 넣지 않아도 됨.
LAW_API_OC=

# 공공데이터포털 일반 인증키(조달청_나라장터쇼핑몰 품목정보 서비스 등) — scripts/external/g2b-api.php 전용(외부 상품 참고 자료 수집).
# data.go.kr 마이페이지에서 'Decoding' 키를 넣는다(Encoding 키도 동작). 값은 .env.local 에만(채팅·커밋 금지). 운영 /app/.env 에는 넣지 않음.
DATA_GO_KR_SERVICE_KEY=

# 국가건설기준센터(KCSC) OpenAPI 인증키 — scripts/legal-sources/kcsc_fetch.php 전용(설계기준·표준시방서 조항 확인).
# kcsc.re.kr 에서 발급. 값은 .env.local 에만(채팅·커밋 금지). 클라우드 세션은 환경 설정의 환경 변수 KCSC_API_KEY 로. 운영 /app/.env 에는 넣지 않음.
KCSC_API_KEY=
