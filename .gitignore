.DS_Store
*.log
public/uploads/*
!public/uploads/.gitkeep

# 로컬 시크릿 (커밋 금지)
.env.local
.env
.env.*
!.env.example


# 배포 백업(scripts/deploy-files.sh가 생성 — 운영 서버 파일 사본, 커밋 금지)
/backup/

# 외부 상품 API 수집(scripts/external/g2b-api.php) — 원본 응답·수집본·진행 상태는 커밋하지 않음(명세 spec.json 만 커밋 가능)
/data/external/g2b/raw/
/data/external/g2b/collected/
/data/external/g2b/state.json
/data/external/g2b/import-report.md
# 제조사 공개 자료 수집(scripts/external/crawl-sources.php) 결과 — 수집본·보고서는 커밋하지 않음
/data/external/crawl/

# 운영 복제 개발 DB 스냅샷·작업 파일(scripts/testdb/devdb.sh) — 운영 데이터, 커밋 금지
/.devdb/
